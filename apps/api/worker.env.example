# Victus capture worker — environment template.
#
# Copy to `worker.env` next to apps/api/ (or anywhere, then point at it with
# WORKER_ENV_FILE) and fill in the values. scripts/run-worker.sh sources this
# file, so plain `KEY=value` lines (no `export`) are correct.
#
# ONE worker process drains TWO queues: WhatsApp captures AND kiosk-gateway
# captures. Scheduling this worker is what makes the kiosk rail live in prod.
# The kiosk path needs neither OpenCV nor the WhatsApp flag to PROCESS a capture
# (the signal is extracted in the kiosk browser); it only needs WhatsApp sending
# to DELIVER the participant's secure-portal link + one-time code.

# --- interpreter (used by scripts/run-worker.sh) ----------------------------
# Point at the venv's python. On cPanel this is under ~/virtualenv/.../bin.
PYTHON=python3

# --- shared with the API (use the SAME values as the API) -------------------
API_ENV=production
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/victus
# The app refuses to boot in production with placeholder secrets — set the real
# ones even though the worker doesn't functionally use all of them.
JWT_SECRET_KEY=
INTERNAL_SERVICE_TOKEN=
PSEUDO_SALT=

# --- worker tuning (optional; defaults shown) -------------------------------
# WORKER_BATCH_SIZE=5
# WORKER_MAX_ATTEMPTS=3
# WORKER_RETRY_BACKOFF_S=60
# WORKER_POLL_INTERVAL_S=5
# Absolute, writable scratch dir for the WhatsApp video download (kiosk uses none).
WORKER_MEDIA_DIR=/home/USER/victus-media
# WORKER_PURGE_MEDIA=true

# --- WhatsApp Cloud rail (off until Meta business verification) -------------
# false: the worker never calls Meta. Kiosk captures are still PROCESSED and
#        visible to clinicians, but the participant's OTP/portal message is not
#        delivered (it prints to the worker log instead).
# true:  requires the token + phone id below; enables outbound delivery and the
#        WhatsApp video rail.
WHATSAPP_SEND_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
